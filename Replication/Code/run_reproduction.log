. do run_reproduction.do 

. * Stata script to run the SCM replication for Germany only in user folder
. 
. clear all

. set more off

. 
. * Install SCM packages if missing
. cap ssc install synth

. cap ssc install moremata

. cap ssc install outtable

. 
. * Define working path
. global hp = "c:\Users\22984\Desktop\Leuven slide\Applied econometrics\Applied
>  econometrics\Replication"

. global Fig = "$hp\Output\"

. global Tab = "$hp\Output\"

. global Data = "$hp\Data\"

. 
. * Set SCM parameters for Germany only (id == 9)
. global countries_name Germany

. global countries_code DEU

. global countries 9

. global number_countries = 12  // Set to 12 to avoid conformability error in 1
> _SCM_Annual.do

. 
. * Outcome and Covariates
. global outcome normgdp_s

. global outcomecg normgdp_scg

. 
. global covariates csh_c csh_i csh_g csh_x csh_m csh_emp csh_prod inflation

. global number_covariates = 8

. global covariatescg csh_ccg csh_icg csh_gcg csh_xcg csh_mcg csh_empcg csh_pro
> dcg inflationcg

. 
. * Treatment dates
. global treatment = 1999

. global treatment_GRC = 2001

. 
. * Sample years
. global begin = 1970

. global end = 2007

. 
. * Rob checks
. global remove_1 

. global remove_2 

. global remove_3 

. global remove_nr = 0

. 
. * Donor countries
. global donor_names Australia Canada Chile Denmark Iceland Israel Korea Mexico
>  NewZealand Norway Sweden Switzerland UnitedKingdom UnitedStates

. global donor_countries 2 4 5 6 11 13 15 17 19 20 23 24 25 26

. global number_donor = 14

. 
. * Run the SCM script
. do 1_SCM_Annual.do

.                         *** Synthetic Control Method - Specification Annual *
> **
.  
. /*
> The file SCM_Annual.do runs the synthetic control method (SCM) for each of th
> e treated 
> countries: Austria, Belgium, Finland, France, Germany, Ireland, Italy, 
> Luxembourg, The Netherlands, Portugal and Spain.
> 
> First, it runs the synth package to mimic each countries' normalized 
> log of real GDP per capita using as predictors the log real GPD per capita 
> itself and its lags, the shares of its components: private and government 
> consumption, investment, and net exports, the employment share and the labor
> productivity growth. To do that one needs the synth package easily obtained 
> by running: ssc install synth
> 
> Second, we construct series for each doppelgangers' log real GDP per capita 
> by using the weights computed by the SCM. 
> 
> Third, we construct a matrix to save the weights attributed to each 
> OECD and non-eurozone countries. 
> 
> Finally, we save the weights as a tex document: Weights, and the series in a 
> new
> .dta file for each country which we then aggregate in the aggregation do file
> .
> */
. 
. 
. clear

. set more off

. 
. * run paths do file
. do Paths.do

. *================== Set working path ========================================
. 
. global hp = "c:\Users\22984\Desktop\Leuven slide\Applied econometrics\Applied
>  econometrics\Replication"

. 
. global Fig = "$hp\Output\"

. global Tab = "$hp\Output\"

. global Data = "$hp\Data\"

. 
end of do-file

. 
. 
. * Decide on Specification (Annual or Quarterly) and whether 
. *global SPECIFICATION Annual
. *global COMPONENTS On
. 
. *upload correspondent global variables
. *do Master_EMU.do
. 
. 
. 
. *****************************************************************************
> ***
.                                       *SCM*
. *****************************************************************************
> ***
. 
. 
. **Construct matrix for weights used for SCG construction
. local a = 1

. local p= $number_donor - $remove_nr

. matrix weights = J(`p' ,$number_countries ,0)

. 
. *still needs to be automatized
. matrix rownames weights = $donor_names

. matrix colnames weights = "Austria"  "Belgium" "Finland" "France" "Germany" /
> //
> "Greece" "Ireland" "Italy" "Luxembourg" "Netherlands" "Portugal" "Spain"

. 
.  
. foreach x in $countries {
  2. 
. *___________________1. Run the  Synthetic Control ___________________________
> __* allopt
. 
. use "${Data}Analysis_Annual", clear
  3. 
. set more off
  4. replace donor=0 if country=="$remove_1"
  5. replace donor=0 if country=="$remove_2"
  6. replace donor=0 if country=="$remove_3"
  7. keep if id==`x' | donor==1
  8. replace id=1 if id == `x'
  9. xtset id date
 10. xtset id h
 11. 
. 
. if (code=="GRC") {
 12.         local treatment_h = ($treatment_GRC-$begin)+1
 13.         local max = `treatment_h'-1
 14.         synth $outcome $covariates $outcome $outcome(2(1)`max'), trunit(1)
>  trperiod(`treatment_h') nested allopt
 15. }
 16. else{
 17.         local treatment_h = ($treatment-$begin)+1
 18.         local max = `treatment_h'-1
 19.         synth $outcome $covariates $outcome $outcome(2(1)`max'), trunit(1)
>  trperiod(`treatment_h') nested allopt
 20. }
 21. 
. 
. *______________________2. Obtain economic series for SCG_____________________
> __*
. 
. 
. foreach var in $outcome $covariates {
 22.         gen `var'cg=.
 23. }   
 24. 
. *Get weights from SCM
. matrix w = e(W_weights)
 25. 
. mat list w
 26. 
. *For each pair id-weight compute contribution to SCG's variables of interest
. foreach var in $outcome $covariates{
 27.         forval c = 1/`p' {
 28.                 replace `var'cg = w[`c',2]*`var' if id == w[`c',1]
 29.         }
 30. }
 31. 
. /*
> Sum to compute SCG variables of interest - trick to easily compute the 
> weighted average - [_n+max{h}] only times the amount of donor countries
> */
. 
. if ("$begin"=="1973") {
 32.                 foreach var in $outcome $covariates {
 33.                         replace `var'cg = `var'cg[_n+35] + `var'cg[_n+70] 
> + `var'cg[_n+105] + `var'cg[_n+140] + `var'cg[_n+175] + `var'cg[_n+210] + `va
> r'cg[_n+245] +`var'cg[_n+280] + `var'cg[_n+315] + `var'cg[_n+350] +`var'cg[_n
> +385] + `var'cg[_n+420] + `var'cg[_n+455] + `var'cg[_n+490]
 34.         }
 35. }
 36. 
. if ("$begin"=="1981") {
 37.                 foreach var in $outcome $covariates {
 38.                         replace `var'cg = `var'cg[_n+27] + `var'cg[_n+54] 
> + `var'cg[_n+81] + `var'cg[_n+108] + `var'cg[_n+135] + `var'cg[_n+162] + `var
> 'cg[_n+189] +`var'cg[_n+216] + `var'cg[_n+243] + `var'cg[_n+270] +`var'cg[_n+
> 293] + `var'cg[_n+324] + `var'cg[_n+351] + `var'cg[_n+378]
 39.         }
 40. }
 41. 
. if ("$begin"=="1986") {
 42.                 foreach var in $outcome $covariates {
 43.                         replace `var'cg = `var'cg[_n+22] + `var'cg[_n+44] 
> + `var'cg[_n+66] + `var'cg[_n+88] + `var'cg[_n+110] + `var'cg[_n+132] + `var'
> cg[_n+154] +`var'cg[_n+176] + `var'cg[_n+198] + `var'cg[_n+220] +`var'cg[_n+2
> 42] + `var'cg[_n+264] + `var'cg[_n+286] + `var'cg[_n+308]
 44.         }
 45. }
 46. 
. if ("$begin"=="1970") {
 47. 
.         if ("$remove_nr"=="0") {
 48.                 foreach var in $outcome $covariates {
 49.                         replace `var'cg = `var'cg[_n+38] + `var'cg[_n+76] 
> + `var'cg[_n+114] + `var'cg[_n+152] + `var'cg[_n+190] + `var'cg[_n+228] + `va
> r'cg[_n+266] +`var'cg[_n+304] + `var'cg[_n+342] + `var'cg[_n+380] +`var'cg[_n
> +418] + `var'cg[_n+456] + `var'cg[_n+494] + `var'cg[_n+532]
 50.                 }
 51.         }
 52.         else if ("$remove_nr"=="1") {
 53.                 foreach var in $outcome $covariates {
 54.                         replace `var'cg = `var'cg[_n+38] + `var'cg[_n+76] 
> + `var'cg[_n+114] + `var'cg[_n+152] + `var'cg[_n+190] + `var'cg[_n+228] + `va
> r'cg[_n+266] +`var'cg[_n+304] + `var'cg[_n+342] + `var'cg[_n+380] +`var'cg[_n
> +418] + `var'cg[_n+456] + `var'cg[_n+494]
 55.                 }       
 56.         }
 57.         else if ("$remove_nr"=="2") {
 58.                 foreach var in $outcome $covariates {
 59.                         replace `var'cg = `var'cg[_n+38] + `var'cg[_n+76] 
> + `var'cg[_n+114] + `var'cg[_n+152] + `var'cg[_n+190] + `var'cg[_n+228] + `va
> r'cg[_n+266] +`var'cg[_n+304] + `var'cg[_n+342] + `var'cg[_n+380] +`var'cg[_n
> +418] + `var'cg[_n+456]
 60.                 }
 61.         }
 62.         else if ("$remove_nr"=="3") {
 63.                 foreach var in $outcome $covariates {
 64.                         replace `var'cg = `var'cg[_n+38] + `var'cg[_n+76] 
> + `var'cg[_n+114] + `var'cg[_n+152] + `var'cg[_n+190] + `var'cg[_n+228] + `va
> r'cg[_n+266] +`var'cg[_n+304] + `var'cg[_n+342] + `var'cg[_n+380] +`var'cg[_n
> +418]
 65.                 }
 66.         }
 67. }
 68.  
.         
. *______________3. Contruct matrix with the weights used in the SCM___________
> __*
. 
. forvalues c=1/`p' {
 69.         local flag = 100*(w[`c',2])
 70.         matrix weights[`c',`a']= `flag' 
 71. }
 72. local a=`a'+1
 73. 
. //Save the dataset with the contructed SCM series
. local c = country
 74. keep if id==1
 75. keep code date $outcomecg $covariatescg 
 76. save "${Data}Auxi\SCM_`x'_Annual", replace
 77. }
