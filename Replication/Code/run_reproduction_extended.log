. * 3. Leave-One-Out (LOO) checks in Stata
. * ===========================================================================
> ===
. display "== Running LOO in Stata (nested allopt) =="
== Running LOO in Stata (nested allopt) ==

. * We loop over the top donors for Ex-UK model in Stata.
. * Based on the weights we get: USA (id 26), Sweden (id 23), Switzerland (id 2
> 4), Canada (id 4), Denmark (id 6)
. local top_donors 26 23 24 4 6

. local donor_names_loo UnitedStates Sweden Switzerland Canada Denmark

. 
. * We will save the synthetic paths for each LOO run in a single dataset
. tempfile loo_all_trends

. local first = 1

. 
. foreach d of local top_donors {
  2.     preserve
  3.     use "$Data/Analysis_Annual.dta", clear
  4.     keep if id == `d'
  5.     local dname = country[1]
  6.     restore
  7.     
.     preserve
  8.     use "$Data/Analysis_Annual.dta", clear
  9.     keep if id == 9 | (donor == 1 & id != 25 & id != `d')
 10.     replace id = 1 if id == 9
 11.     xtset id h
 12.     
.     synth normgdp_s csh_c csh_i csh_g csh_x csh_m csh_emp csh_prod inflation 
> normgdp_s normgdp_s(2(1)29), trunit(1) trperiod(30) nested allopt
 13.     
.     matrix w_loo = e(W_weights)
 14.     local p_loo = rowsof(w_loo)
 15.     
.     foreach var in normgdp_s {
 16.         gen `var'cg = .
 17.     }
 18.     forval c = 1/`p_loo' {
 19.         replace normgdp_scg = w_loo[`c',2]*normgdp_s if id == w_loo[`c',1]
 20.     }
 21.     
.     keep if id != 1
 22.     collapse (sum) normgdp_scg, by(year)
 23.     
.     gen type = "Drop `dname'"
 24.     
.     if `first' == 1 {
 25.         save `loo_all_trends', replace
 26.         local first = 0
 27.     }
 28.     else {
 29.         append using `loo_all_trends'
 30.         save `loo_all_trends', replace
 31.     }
 32.     restore
 33. }
